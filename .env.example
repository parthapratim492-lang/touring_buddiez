# Copy this file to .env for local development (never commit the real .env).
# On Render, set these under your service → Environment tab instead — Render
# ignores .env files and reads real environment variables directly.

# Required in production — a long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Recommended — overrides the seeded default admin (admin / admin123).
# Only takes effect on a brand-new, empty database (first run).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deploying

# Points the SQLite database and uploaded images at a persistent disk mount
# instead of the app's own (ephemeral) folder. On Render, attach a persistent
# disk and set this to its mount path, e.g. /var/data. Without this, the
# database and uploaded images are lost on every redeploy/restart.
DATA_DIR=

# Set automatically by Render — leave blank locally, npm start uses 5000.
PORT=
NODE_ENV=development

# Optional — powers the "your tour is confirmed" email sent to a customer
# when the admin marks their booking Confirmed. Without these set, the app
# still works — it just logs what it would have sent instead of emailing.
#
# For Gmail (tourbuddiez@gmail.com): SMTP_PASS must be a 16-character
# Google "App Password", not the regular account password —
# Google Account → Security → 2-Step Verification → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tourbuddiez@gmail.com
SMTP_PASS=
MAIL_FROM=Touring Buddiez <tourbuddiez@gmail.com>
